# OpenAI-compatible LLM API used by src/live_clipper/cheap_model_client.py
# Keep secrets here or in your shell environment. Non-secret defaults can live in live-clipper.toml.
CHEAP_MODEL_API_BASE=https://apihub.agnes-ai.com/v1
CHEAP_MODEL_API_KEY=
CHEAP_MODEL_NAME=agnes-2.0-flash
LLM_API_BASE=
LLM_MODEL=

# ASR provider configuration
ASR_BACKEND=mlx_whisper
ASR_MODEL=mlx-community/whisper-large-v3-turbo
ASR_LANGUAGE=zh
HF_TOKEN=

# Optional OpenAI-compatible cloud ASR fallback configuration
ASR_API_BASE=https://api.openai.com/v1
ASR_API_KEY=

# Failure log privacy: redacted, full, or disabled
FAILURE_LOG_MODE=redacted
FAILURE_LOG_MAX_CHARS=2000
